{
  "name": "agentox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "server": "node scripts/server.mjs",
    "build:gateway": "esbuild gateway/server.mjs --bundle --platform=node --format=esm --target=node20 --outfile=gateway/dist/gateway.mjs --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" --log-level=warning",
    "gateway": "node gateway/server.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "^3.1165.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "description": "agentox: the control room for your AI workforce",
  "engines": {
    "node": ">=24"
  }
}
